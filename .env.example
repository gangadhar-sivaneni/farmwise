# FarmWise Gemini API Configuration
# Get your Google Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Create a .env file in the project root and add your real key:
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override (defaults to gemini-2.5-flash, with automatic fallback to gemini-1.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
